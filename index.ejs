<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social Lab - Step 2</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
        }

        .main-title {
            font-weight: 800;
            font-size: 1.8rem;
            background: linear-gradient(90deg, #6366f1, #a855f7);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
        }

        /* Card Compatta Glassmorphism */
        .compact-card {
            background: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 1.5rem;
        }

        /* Input più piccoli e curati */
        .form-control-sm {
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            padding: 0.5rem 0.8rem;
        }

        .btn-gradient {
            background: linear-gradient(90deg, #6366f1, #a855f7);
            border: none;
            color: white;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .btn-gradient:hover {
            opacity: 0.9;
            transform: scale(1.02);
            color: white;
        }

        /* Gallery Cards */
        .post-card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            background: white;
            transition: transform 0.3s ease;
        }

        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }

        .img-gallery {
            height: 160px; /* Altezza ridotta per vedere più post */
            object-fit: cover;
        }

        .badge-tag {
            background-color: #f1f5f9;
            color: #6366f1;
            font-size: 0.7rem;
            border-radius: 6px;
        }
    </style>
</head>
<body>

    <div class="container py-4">
        <header class="text-center">
            <h1 class="main-title">📸 Social Lab 2.0</h1>
        </header>

        <div class="row justify-content-center mb-5">
            <div class="col-lg-11">
                <div class="compact-card">
                    <form action="/post" method="POST" enctype="multipart/form-data">
                        <div class="row g-2 align-items-end">
                            
                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-1 ml-1">Titolo</label>
                                <input type="text" name="testo" class="form-control form-control-sm" placeholder="Titolo post" required>
                            </div>

                            <div class="col-md-2">
                                <label class="small fw-bold text-muted mb-1">Tag</label>
                                <input type="text" name="info" class="form-control form-control-sm" placeholder="#viaggio">
                            </div>

                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-1">Immagine</label>
                                <input type="file" name="immagine" class="form-control form-control-sm" accept="image/*" required>
                            </div>

                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-1">Descrizione</label>
                                <input type="text" name="descrizione" class="form-control form-control-sm" placeholder="Breve nota...">
                            </div>

                            <div class="col-md-1">
                                <button type="submit" class="btn btn-gradient btn-sm w-100 py-2" title="Pubblica">
                                    🚀
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center mb-4">
            <h2 class="h5 fw-bold m-0 text-secondary">La tua Gallery</h2>
            <div class="flex-grow-1 ms-3 border-bottom opacity-25"></div>
        </div>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            <% if (posts.length === 0) { %>
                <div class="col-12 text-center py-4">
                    <p class="text-muted">Nessun post. Carica la tua prima foto!</p>
                </div>
            <% } else { %>
                <% posts.reverse().forEach(post => { %> 
                    <div class="col">
                        <div class="post-card shadow-sm h-100">
                            <a href="/post/<%= post.id %>">
                                <img src="<%= post.immagine %>" class="card-img-top img-gallery" alt="Post">
                            </a>
                            <div class="p-3">
                                <span class="badge badge-tag mb-1"><%= post.info || '#post' %></span>
                                <h6 class="fw-bold mb-1 text-truncate"><%= post.testo %></h6>
                                <p class="text-muted small mb-0 text-truncate" style="font-size: 0.75rem;">
                                    <%= post.descrizione %>
                                </p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>